# PostgreSQL connection string (e.g. Neon, Supabase, local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Public site URL used for SEO metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL="https://www.shreeshyamintimpex.com"

# Admin authentication secret - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be set in production (min 32 chars) - the app throws without it
ADMIN_JWT_SECRET=

# Admin session lifetime in days (optional, default 7)
# ADMIN_SESSION_DAYS=7

# Default credentials for `pnpm admin:create` (optional)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!

# Zoho SMTP for admin notification emails (optional - emails are skipped when unset)
# ZOHO_SMTP_HOST=smtp.zoho.in
# ZOHO_SMTP_PORT=465
# ZOHO_SMTP_SECURE=true
# ZOHO_SMTP_USER=
# ZOHO_SMTP_PASSWORD=
# ADMIN_NOTIFICATION_EMAIL=
